EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER ship this in the app bundle. Only used by scripts/import-workout-program.ts
# to write template data, bypassing RLS. Keep this out of EXPO_PUBLIC_* and out of version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
